# --- Telegram (new bot via @BotFather for AUDUSD alerts) ---
TELEGRAM_TOKEN=your_audusd_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Twelve Data (new account, fresh 800 credits/day) ---
TWELVE_API_KEY=your_twelvedata_api_key_here

# --- Bot identity (used by shared risk tracker) ---
BOT_NAME=AUDUSD_BOT

# --- Shared risk tracker ---
# IMPORTANT: This path must be IDENTICAL in both the GBPUSD bot's .env
# and this AUDUSD bot's .env, and both bots must run on the same
# machine/server so they read/write the same state file.
SHARED_RISK_STATE_PATH=/home/youruser/shared_risk_state.json

# FundingPips #20084818 account settings
ACCOUNT_SIZE=8000
DAILY_LOSS_LIMIT_PCT=3.0
RISK_PER_TRADE_PCT=0.5

# How long a registered signal counts toward shared exposure before
# expiring automatically (seconds). 14400 = 4 hours.
SIGNAL_EXPIRY_SECONDS=14400

# --- Twelve Data cache file (separate per bot, keep default) ---
TD_CACHE_FILE=td_cache.json
